<head>
  <title>
    {% if class == "home" %} {{ title }} – A December full of art for good {%
    else %} {{ title }} – The Advent Project {% endif %}
  </title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    rel="stylesheet"
    type="text/css"
    href="/_assets/fonts/free-lunch/free-lunch.css"
  />
  <link
    rel="stylesheet"
    type="text/css"
    href="/_assets/fonts/advent-symbols/advent-symbols.css"
  />
  <link
    rel="stylesheet"
    type="text/css"
    href="/_assets/fonts/mallory-compact/mallory-compact.css"
  />
  <link
    rel="stylesheet"
    type="text/css"
    href="/_assets/fonts/martina-plantijn/martina-plantijn.css"
  />
  <link rel="stylesheet" type="text/css" href="/_css/reset.css" />
  <link rel="stylesheet" type="text/css" href="/_css/grid.css" />
  <link rel="stylesheet" type="text/css" href="/_css/style.css" />

  <!-- Favicons -->
  <link
    rel="icon"
    type="image/png"
    href="/_assets/favicon/favicon-32x32.png"
    sizes="32x32"
  />
  <link
    rel="icon"
    type="image/png"
    href="/_assets/favicon/favicon-96x96.png"
    sizes="96x96"
  />
  <link
    rel="icon"
    type="image/png"
    href="/_assets/favicon/favicon-192x192.png"
    sizes="192x192"
  />
  <link
    rel="apple-touch-icon-precomposed"
    href="/_assets/favicon/favicon-180x180.png"
  />
  <meta
    name="msapplication-TileImage"
    content="/_assets/favicon/favicon-270x270.png"
  />

  <!-- Social cards -->
  <meta name="og:type" content="website" />
  {% if class == "home" %}
  <meta name="og:title" content="The Advent Project" />
  {% else %}
  <meta name="og:title" content="{{ title }} – The Advent Project" />
  {% endif %}
  <meta property="og:description" content="A December full of art for good." />
  <meta itemprop="description" content="A December full of art for good." />
  <meta
    name="og:image"
    content="https://adventproject.org/_assets/social-card.jpg"
  />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body class="{{ texture }}">
  <header id="site-header" class="container">
    <nav class="row justify-content-between">
      <div class="col-2">
        <a href="/" class="icon custom" id="header-logo">
          <i class="adv-icon adv-logo"></i>
        </a>
      </div>
    </nav>
  </header>
</body>

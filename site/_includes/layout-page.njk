<!DOCTYPE html>
<html lang="en">
	{% include "./header.njk" %}

	<div id="site-wrapper">
		<article id="{{ id }}">
			{% if class == "home" %}
				{{ content | safe }}
			{% elif class == "pitch" %}
				<div id="pitch-content" class="container">
					<div class="row">
						<div class="col-12">
							<h1>{{ title }}</h1>
						</div>
					</div>
					<div class="row justify-content-between">
						<div id="pitch-text" class="col-md-5 col-lg-4" data-auto-expand="yes" data-expand-selector="h3">
							{{ content | safe }}
						</div>
						<div class="col-md-6 col-lg-7">
							<div id="pitch-form">
								<h2>Submit your pitch:</h2>
								<div data-tf-widget="Y9zBC6oz" data-tf-hide-headers data-tf-iframe-props="title=2022 Submissions" data-tf-medium="snippet" style="width:100%;height:500px;"></div>
								<script src="//embed.typeform.com/next/embed.js"></script>
							</div>
						</div>
					</div>
				</div>
			{% else %}
				<div class="container">
					<div class="row justify-content-center">
						<div class="col-md-8">
							{{ content | safe }}
						</div>
					</div>
				</div>
			{% endif %}
		</article>
	</div>

	{% include "./footer.njk" %}
</html>
